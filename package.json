{
  "name": "clonely-fanz-public",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build-no-errors": "npm run build",
    "lint": "node scripts/audit-landing.mjs",
    "preview": "vite preview",
    "types:supabase": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.ts",
    "typecheck": "tsc -p tsconfig.public.json --noEmit",
    "audit:landing": "node scripts/audit-landing.mjs",
    "typecheck:legacy": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.4.38",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
